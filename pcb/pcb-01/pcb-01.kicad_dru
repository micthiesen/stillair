(version 1)

# PCB-01 custom rules (docs/electrical.md > PCB-01 mechanical definition).

# Mounting holes are isolated from circuit ground: keep all copper outside an
# 8 mm diameter circle around each 3.2 mm NPTH. The NPTH pad is Ø3.7, so
# pad-edge + 2.15 mm = r4.0 (Ø8). Copper items only - component/courtyard
# spacing is enforced by the placement tooling (pcb/tools), and text is exempt.
(rule "mounting-hole-keepout"
  (condition "(B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4')) && (A.Type == 'Pad' || A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Zone')")
  (constraint physical_clearance (min 2.15mm)))
